# Gemini API keys are NOT configured on the server.
# Each user enters their own key in the app (Provider Settings). The key is kept in that
# browser's storage (not encrypted) and sent to this server only to forward each request;
# the server does not store it.

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Set to true only when the app runs behind a reverse proxy or load balancer (e.g. Cloud Run).
# Without it, rate limiting uses the connecting address and cannot be spoofed.
# TRUST_PROXY=true

# Optional: HOST defaults to 127.0.0.1 locally and 0.0.0.0 in production. PORT defaults to 3000.
# HOST=127.0.0.1
# PORT=3000

# Optional: base URL of the server when the web app is packaged elsewhere (e.g. the Android app).
# VITE_API_BASE=https://your-server.example.com
